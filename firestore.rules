rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  function admin(){return signed() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';}
  function owner(field){return signed() && resource.data[field] == request.auth.uid;}
  match /users/{uid} {
   allow create: if signed() && request.auth.uid == uid && request.resource.data.role == 'user';
   allow read: if signed() && (request.auth.uid == uid || admin());
   allow update: if signed() && request.auth.uid == uid && request.resource.data.role == resource.data.role && request.resource.data.uid == resource.data.uid;
   allow delete: if admin();
  }
  match /animals/{id} {
   allow read: if resource.data.status == 'approved' || admin() || (signed() && resource.data.ownerId == request.auth.uid);
   allow create: if signed() && request.resource.data.ownerId == request.auth.uid && request.resource.data.status == 'pending';
   allow update: if admin() || (signed() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.status == resource.data.status);
   allow delete: if admin() || (signed() && resource.data.ownerId == request.auth.uid && resource.data.status == 'pending');
  }
  match /adoptionRequests/{id} {
   allow create: if signed() && request.resource.data.requesterId == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.ownerId == get(/databases/$(database)/documents/animals/$(request.resource.data.animalId)).data.ownerId && get(/databases/$(database)/documents/animals/$(request.resource.data.animalId)).data.status == 'approved' && request.auth.uid != request.resource.data.ownerId;
   allow read: if signed() && (resource.data.requesterId == request.auth.uid || resource.data.ownerId == request.auth.uid || admin());
   allow update: if admin() || (signed() && resource.data.ownerId == request.auth.uid && request.resource.data.requesterId == resource.data.requesterId && request.resource.data.animalId == resource.data.animalId && request.resource.data.ownerId == resource.data.ownerId);
   allow delete: if admin() || (signed() && resource.data.requesterId == request.auth.uid && resource.data.status == 'pending');
  }
  match /lostFound/{id} {
   allow read: if resource.data.status == 'approved' || admin() || (signed() && resource.data.authorId == request.auth.uid);
   allow create: if signed() && request.resource.data.authorId == request.auth.uid && request.resource.data.status == 'pending';
   allow update: if admin() || (signed() && resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId && request.resource.data.status == resource.data.status);
   allow delete: if admin() || (signed() && resource.data.authorId == request.auth.uid && resource.data.status == 'pending');
  }
  match /reports/{id} {
   allow create: if signed() && request.resource.data.reporterId == request.auth.uid && request.resource.data.status == 'pending';
   allow read, update, delete: if admin();
  }
  match /fosterApplications/{id} {
   allow create: if signed() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
   allow read: if admin() || owner('userId');
   allow update, delete: if admin();
  }
  match /donations/{id} {
   allow create: if signed() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
   allow read: if admin() || owner('userId');
   allow update, delete: if admin();
  }
  match /volunteers/{id} {
   allow create: if signed() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
   allow read: if admin() || owner('userId');
   allow update, delete: if admin();
  }
  match /clinics/{id} {
   allow read: if resource.data.status == 'approved' || admin();
   allow create: if admin();
   allow update, delete: if admin();
  }
  match /conversations/{id} {
   allow create: if signed() && request.resource.data.memberIds is list && request.auth.uid in request.resource.data.memberIds && request.resource.data.memberIds.size() == 2;
   allow read: if signed() && request.auth.uid in resource.data.memberIds;
   allow update: if signed() && request.auth.uid in resource.data.memberIds && request.resource.data.memberIds == resource.data.memberIds && request.resource.data.animalId == resource.data.animalId;
   allow delete: if admin();
   match /messages/{mid} {
    function member(){return signed() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.memberIds;}
    allow read: if member();
    allow create: if member() && request.resource.data.senderId == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000;
    allow update, delete: if false;
   }
  }
  match /favorites/{id} {
   allow read, delete: if signed() && resource.data.userId == request.auth.uid;
   allow create: if signed() && request.resource.data.userId == request.auth.uid;
  }
 }
}